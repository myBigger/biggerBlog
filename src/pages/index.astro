---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="ac-section-block pt-8">
      <div class="ac-hero-panel">
        <a
          target="_blank"
          href="/rss.xml"
          class="ac-hero-panel__rss inline-block"
          aria-label="rss feed"
          title="RSS 订阅"
        >
          <IconRss
            width={20}
            height={20}
            class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS 订阅</span>
        </a>

        <p class="pe-8 text-base font-medium leading-relaxed sm:text-lg">
          记录真实踩坑和实践经验的技术博客
        </p>
        <p class="mt-3 text-sm font-semibold">
          <a href="/tags/后端踩坑手记/" class="text-accent hover:underline">
            正在连载：后端踩坑手记（Java 踩坑实录）→
          </a>
        </p>
        {
          SOCIALS.length > 0 && (
            <div class="mt-4 flex max-sm:flex-col sm:items-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">社交链接:</div>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "ac-section-block pt-10",
            { "mb-0": recentPosts.length > 0 },
          ]}
        >
          <SectionHeading title="精选文章" />
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" featured {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="ac-section-block pt-10">
          <SectionHeading title="最新文章" />
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && (
                  <Card variant="h3" colorIndex={index} {...data} />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton pill href="/posts/">
        全部文章
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>