---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

const LIST_COLORS = [
  "default",
  "app-teal",
  "app-yellow",
  "app-green",
  "app-orange",
] as const;

type Props = {
  variant?: "h2" | "h3";
  colorIndex?: number;
  featured?: boolean;
} & CollectionEntry<"blog">;

const {
  variant: Heading = "h2",
  colorIndex = 0,
  featured = false,
  id,
  data,
  filePath,
} = Astro.props;

const cardColor = featured
  ? "app-blue"
  : LIST_COLORS[colorIndex % LIST_COLORS.length];

const { title, description, slug, ...props } = data;
---

<li class="my-4">
  <a
    href={getPath(id, filePath, true, slug)}
    class:list={[
      "ac-card ac-shadow-3d block",
      `ac-card--${cardColor}`,
      "focus-visible:no-underline focus-visible:outline-2",
    ]}
  >
    <Heading
      class="text-lg font-bold leading-snug"
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
    <Datetime {...props} />
    {description && <p class="mt-2 text-sm opacity-90">{description}</p>}
  </a>
</li>
