---
import type { HTMLAttributes } from "astro/types";

type Props = { disabled?: boolean; pill?: boolean } & HTMLAttributes<"a">;

const { disabled, pill = false, class: className, ...attrs } = Astro.props;

const Button = disabled ? "span" : "a";
---

<Button
  aria-disabled={disabled}
  class:list={[
    "group inline-flex items-center gap-1",
    { "ac-btn": pill && !disabled },
    { "opacity-50": disabled },
    className,
  ]}
  {...attrs}
>
  <slot />
</Button>
